// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Availability {
  AVAILABLE
  LOOKING_FOR_TEAM
  BUSY
  TEAM_FULL
}

enum UserRoleEnum {
  ADMIN
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  ONGOING
  COMPLETED
  CANCELLED
}

enum TeamStatus {
  DRAFT
  ACTIVE
  FULL
  CLOSED
}

enum RoleStatus {
  DRAFT
  ACTIVE
  PARTIALLY_FILLED
  FULL
  CLOSED
  EXPIRED
}

enum RequirementType {
  REQUIRED
  PREFERRED
}

enum PreferredExperience {
  ANY
  BEGINNER
  SOME_EXPERIENCE
  EXPERIENCED
}

enum MembershipRole {
  LEADER
  CO_LEADER
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  LEFT
  REMOVED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  AUTO_CLOSED
  WITHDRAWN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum TargetType {
  USER
  TEAM
  PROJECT
}

// ==========================================
// IDENTITY & PROFILE
// ==========================================

model College {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  domain    String
  createdAt DateTime @default(now()) @map("created_at")

  departments Department[]
  users       User[]

  @@map("colleges")
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  collegeId String   @map("college_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  users   User[]

  @@map("departments")
}

model User {
  id                 String             @id @default(uuid()) @db.Uuid
  username           String             @unique
  name               String
  profilePhoto       String?            @map("profile_photo")
  collegeId          String?            @map("college_id") @db.Uuid
  departmentId       String?            @map("department_id") @db.Uuid
  year               Int?
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  bio                String?
  availability       Availability       @default(AVAILABLE)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  college    College?    @relation(fields: [collegeId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  privateData         UserPrivate?
  roles               UserRole[]
  verificationReq     VerificationRequest?
  verificationReviews VerificationRequest[] @relation("Reviewer")

  skills           UserSkill[]
  interests        UserInterest[]
  createdSkillRels SkillRelationship[] @relation("CreatedByAdmin")
  projects         Project[]
  achievements     Achievement[]

  authoredAnnouncements Announcement[]
  teamMemberships       TeamMember[]
  applications          Application[]
  sentInvitations       Invitation[]   @relation("Sender")
  receivedInvitations   Invitation[]   @relation("Recipient")
  ratingsGiven          Rating[]       @relation("Rater")
  ratingsReceived       Rating[]       @relation("Ratee")
  uploadedFiles         TeamFile[]
  createdLinks          TeamLink[]
  messagesSent          Message[]
  notifications         Notification[]
  bookmarks             Bookmark[]
  activityLogs          ActivityLog[]

  @@index([username])
  @@index([verificationStatus])
  @@index([collegeId])
  @@index([departmentId])
  @@index([availability])
  @@map("users")
}

model UserPrivate {
  userId       String   @id @map("user_id") @db.Uuid
  collegeEmail String   @unique @map("college_email")
  erp          String   @unique
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([erp])
  @@index([collegeEmail])
  @@map("user_private")
}

model UserRole {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  role        UserRoleEnum
  grantedById String?      @map("granted_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@index([role])
  @@map("user_roles")
}

model VerificationRequest {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @unique @map("user_id") @db.Uuid
  erp             String
  status          VerificationStatus @default(PENDING)
  documentUrl     String?            @map("document_url")
  reviewerId      String?            @map("reviewer_id") @db.Uuid
  rejectionReason String?            @map("rejection_reason")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("Reviewer", fields: [reviewerId], references: [id])

  @@map("verification_requests")
}

// ==========================================
// SKILLS & PORTFOLIO
// ==========================================

model Skill {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  isCustom Boolean @default(false) @map("is_custom")

  userSkills    UserSkill[]
  userInterests UserInterest[]
  projectSkills ProjectSkill[]
  roleSkills    RoleSkill[]
  relatedFrom   SkillRelationship[] @relation("SourceSkill")
  relatedTo     SkillRelationship[] @relation("RelatedSkill")

  @@map("skills")
}

model UserSkill {
  userId  String     @map("user_id") @db.Uuid
  skillId String     @map("skill_id") @db.Uuid
  level   SkillLevel

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([userId])
  @@index([skillId])
  @@map("user_skills")
}

model UserInterest {
  userId    String   @map("user_id") @db.Uuid
  skillId   String   @map("skill_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([userId])
  @@index([skillId])
  @@map("user_interests")
}

model SkillRelationship {
  sourceSkillId        String   @map("source_skill_id") @db.Uuid
  relatedSkillId       String   @map("related_skill_id") @db.Uuid
  relationshipStrength Int      @map("relationship_strength")
  createdById          String   @map("created_by") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at")

  sourceSkill  Skill @relation("SourceSkill", fields: [sourceSkillId], references: [id], onDelete: Cascade)
  relatedSkill Skill @relation("RelatedSkill", fields: [relatedSkillId], references: [id], onDelete: Cascade)
  createdBy    User  @relation("CreatedByAdmin", fields: [createdById], references: [id])

  @@id([sourceSkillId, relatedSkillId])
  @@index([sourceSkillId])
  @@map("skill_relationships")
}

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String
  description String
  role        String
  githubLink  String?  @map("github_link")
  figmaLink   String?  @map("figma_link")
  demoLink    String?  @map("demo_link")
  isPrivate   Boolean  @default(false) @map("is_private")
  date        DateTime

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills ProjectSkill[]

  @@map("projects")
}

model ProjectSkill {
  projectId String @map("project_id") @db.Uuid
  skillId   String @map("skill_id") @db.Uuid

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@index([projectId])
  @@index([skillId])
  @@map("project_skills")
}

model Achievement {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String
  description String
  date        DateTime
  link        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("achievements")
}

// ==========================================
// EVENTS & TEAMS
// ==========================================

model Event {
  id                   String      @id @default(uuid()) @db.Uuid
  name                 String
  description          String
  startDate            DateTime    @map("start_date")
  endDate              DateTime    @map("end_date")
  registrationDeadline DateTime    @map("registration_deadline")
  rules                String
  bannerUrl            String?     @map("banner_url")
  teamSizeInfo         String      @map("team_size_info")
  status               EventStatus @default(DRAFT)

  announcements Announcement[]
  teams         Team[]
  teamMembers   TeamMember[]

  @@map("events")
}

model Announcement {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String?  @map("event_id") @db.Uuid
  title       String
  content     String
  authorId    String   @map("author_id") @db.Uuid
  publishedAt DateTime @default(now()) @map("published_at")

  event  Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@map("announcements")
}

model Team {
  id          String     @id @default(uuid()) @db.Uuid
  eventId     String?    @map("event_id") @db.Uuid
  name        String
  description String
  status      TeamStatus @default(DRAFT)

  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  roles        TeamRole[]
  members      TeamMember[]
  applications Application[]
  invitations  Invitation[]
  ratings      Rating[]
  files        TeamFile[]
  links        TeamLink[]
  conversation Conversation?
  activityLogs ActivityLog[]

  @@map("teams")
}

model TeamRole {
  id                    String              @id @default(uuid()) @db.Uuid
  teamId                String              @map("team_id") @db.Uuid
  name                  String
  seatsRequired         Int                 @map("seats_required")
  preferredLevel        SkillLevel?         @map("preferred_level")
  preferredExperience   PreferredExperience @default(ANY) @map("preferred_experience")
  preferredAvailability Availability?       @map("preferred_availability")
  expiry                DateTime
  status                RoleStatus          @default(DRAFT)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  skills       RoleSkill[]
  members      TeamMember[]
  applications Application[]
  invitations  Invitation[]

  @@index([teamId])
  @@index([status])
  @@map("team_roles")
}

model RoleSkill {
  roleId          String          @map("role_id") @db.Uuid
  skillId         String          @map("skill_id") @db.Uuid
  requirementType RequirementType @default(REQUIRED) @map("requirement_type")

  role  TeamRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  skill Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([roleId, skillId])
  @@index([roleId])
  @@index([skillId])
  @@map("role_skills")
}

model TeamMember {
  id             String           @id @default(uuid()) @db.Uuid
  teamId         String           @map("team_id") @db.Uuid
  eventId        String?          @map("event_id") @db.Uuid
  roleId         String?          @map("role_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  membershipRole MembershipRole   @map("membership_role")
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now()) @map("joined_at")
  leftAt         DateTime?        @map("left_at")

  team  Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  event Event?    @relation(fields: [eventId], references: [id])
  role  TeamRole? @relation(fields: [roleId], references: [id])
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Partial unique indexes will be handled via migrations or direct SQL.
  // - one_active_team_per_event
  // - one_active_leader_per_team
  // - one_active_co_leader_per_team

  @@index([userId])
  @@index([teamId])
  @@index([roleId])
  @@index([status])
  @@map("team_members")
}

// ==========================================
// COLLABORATION & WORKFLOW
// ==========================================

model Application {
  id        String            @id @default(uuid()) @db.Uuid
  teamId    String            @map("team_id") @db.Uuid
  roleId    String            @map("role_id") @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  message   String?
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now()) @map("created_at")

  team Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role TeamRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([teamId])
  @@index([roleId])
  @@index([status])
  @@map("applications")
}

model Invitation {
  id          String           @id @default(uuid()) @db.Uuid
  teamId      String           @map("team_id") @db.Uuid
  roleId      String           @map("role_id") @db.Uuid
  senderId    String           @map("sender_id") @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  message     String?
  expiry      DateTime
  status      InvitationStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role      TeamRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  sender    User     @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User     @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([senderId])
  @@index([roleId])
  @@index([status])
  @@map("invitations")
}

model Rating {
  id        String   @id @default(uuid()) @db.Uuid
  raterId   String   @map("rater_id") @db.Uuid
  rateeId   String   @map("ratee_id") @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  eventId   String?  @map("event_id") @db.Uuid
  score     Int // Constrained 1-5 via DB constraints
  feedback  String?
  createdAt DateTime @default(now()) @map("created_at")

  rater User @relation("Rater", fields: [raterId], references: [id], onDelete: Cascade)
  ratee User @relation("Ratee", fields: [rateeId], references: [id], onDelete: Cascade)
  team  Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([raterId, rateeId, teamId], name: "one_rating_per_peer_per_team")
  @@map("ratings")
}

model TeamFile {
  id         String   @id @default(uuid()) @db.Uuid
  teamId     String   @map("team_id") @db.Uuid
  uploaderId String   @map("uploader_id") @db.Uuid
  fileName   String   @map("file_name")
  fileUrl    String   @map("file_url")
  createdAt  DateTime @default(now()) @map("created_at")

  team     Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@map("team_files")
}

model TeamLink {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  creatorId String   @map("creator_id") @db.Uuid
  title     String
  url       String
  createdAt DateTime @default(now()) @map("created_at")

  team    Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("team_links")
}

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @unique @map("team_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  team     Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  content        String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("messages")
}

model Notification {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  type          String
  title         String
  content       String
  referenceType String   @map("reference_type")
  referenceId   String   @map("reference_id")
  isRead        Boolean  @default(false) @map("is_read")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model Bookmark {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  targetType TargetType @map("target_type")
  targetId   String     @map("target_id") @db.Uuid
  createdAt  DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId])
  @@index([targetType])
  @@map("bookmarks")
}

model ActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  teamId      String?  @map("team_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  actionType  String   @map("action_type")
  description String
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}
