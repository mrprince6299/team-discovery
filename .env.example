# ==============================================================================
# TEAM DISCOVERY — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this template to .env.local for local development, or populate these 
# environment variables directly in your hosting platform (e.g., Vercel / AWS).
#
# IMPORTANT: DO NOT COMMIT ACTUAL SECRETS OR PASSWORDS TO SOURCE CONTROL.
# ==============================================================================

# 1. DATABASE CONFIGURATION (Server-Only Secret)
# PostgreSQL connection string for Prisma ORM.
# - Production (Supabase Transaction Pooler):
#   postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
# - Local Development (Supabase Docker Stack):
#   postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL="postgresql://postgres:[YOUR_DB_PASSWORD]@[YOUR_DB_HOST]:6543/postgres?sslmode=require&pgbouncer=true"

# 2. SUPABASE PROJECT URL (Client & Server Safe)
# The public API URL for your hosted Supabase instance.
# - Production: https://[YOUR_PROJECT_REF].supabase.co
# - Local Development: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# 3. SUPABASE PUBLIC ANON KEY (Client & Server Safe)
# The public anonymous API key for client-side authentication and realtime subscriptions.
# - Production: Obtain from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-production-supabase-anon-key"

# 4. PRODUCTION SCHEDULER & CRON PROTECTION SECRET (Server-Only Secret)
# A secure 32+ character random token used to authenticate automated cron executions
# for role expiry (/api/cron/expire-roles).
# Generate a strong token with: openssl rand -base64 32
CRON_SECRET="your-secure-32-character-cron-secret-token"

# 5. RUNTIME ENVIRONMENT (Optional / System-Derived)
# In production, hosting platforms (e.g. Vercel) automatically set NODE_ENV to "production".
NODE_ENV="production"
